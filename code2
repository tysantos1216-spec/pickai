import requests
import streamlit as st

# Access your API key securely from Streamlit Secrets
API_KEY = st.secrets["BALLDONTLIE_API_KEY"]
HEADERS = {"Authorization": API_KEY}

def get_player_id(player_name):
    url = f"https://api.balldontlie.io/v1/players?search={player_name}"
    response = requests.get(url, headers=HEADERS)
    if response.status_code == 200:
        data = response.json()['data']
        return data[0]['id'] if data else None
    return None

def get_player_stats(player_id, per_page=10):
    url = f"https://api.balldontlie.io/v1/stats?player_ids[]={player_id}&per_page={per_page}"
    response = requests.get(url, headers=HEADERS)
    if response.status_code == 200:
        return response.json()['data']
    return []